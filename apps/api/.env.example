# انسخ الملف ده لـ .env وحط القيم

# Supabase → Project Settings → Database
# Transaction pooler (port 6543) للتطبيق
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres"
# Session pooler (port 5432) للـ migrations
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"
# لو الباسورد فيها رموز زي @ أو # لازم تتكتب encoded (@ ← %40)

# توقيع الـ access tokens: 32 حرف عشوائي على الأقل
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

PORT=4000

# نفس القيمة في apps/web: الـ API بيثق في IP العميل اللي Next بيبعته (للـ rate limit). مطلوب في الإنتاج.
INTERNAL_API_SECRET=

# تحليل صور الستائر بـ Claude (من غير المفتاح العرض بيتعمل يدوي)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# صور العروض: Supabase Storage (مطلوب في الإنتاج). محليًا من غيرهم الصور بتتحفظ في .uploads/
# Supabase → Project Settings → API: Project URL وservice_role key (للسيرفر بس، أوعى توصل للمتصفح)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=quote-photos
