# انسخ الملف ده لـ .env.local وحط القيم.
# مفيش مفاتيح قاعدة بيانات ولا مفتاح Claude هنا؛ دول في apps/api بس.

# الرابط العام للموقع (Open Graph ولينكات واتساب)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# رابط الـ NestJS API: بيتقري على السيرفر بس ومايوصلش للمتصفح
API_BASE_URL=http://localhost:4000

# نفس قيمة INTERNAL_API_SECRET في apps/api
INTERNAL_API_SECRET=
